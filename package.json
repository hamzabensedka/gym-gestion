{
  "name": "gym-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "expo-camera": {
      "expo": "~54.0.35"
    },
    "expo-haptics": {
      "expo": "~54.0.35"
    },
    "expo-linear-gradient": {
      "expo": "~54.0.35"
    },
    "expo-secure-store": {
      "expo": "~54.0.35"
    },
    "expo-sharing": {
      "expo": "~54.0.35"
    }
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "prisma generate && npm run dev --workspace=@gym/api",
    "dev:mobile": "npm run start --workspace=@gym/mobile",
    "build": "prisma generate && next build",
    "build:vercel": "prisma generate && next build",
    "build:api": "npm run build --workspace=@gym/api",
    "start": "next start",
    "start:api": "npm run start --workspace=@gym/api",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "build:e2e": "cross-env NEXT_PUBLIC_E2E_TEST=true npm run build",
    "test:e2e": "npm run build:e2e && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:db:reset": "tsx scripts/reset-test-db.ts",
    "test:all": "npm run test && npm run test:e2e",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "mobile": "npm run start --workspace=@gym/mobile",
    "api": "npm run dev --workspace=@gym/api"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.3",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.16.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "prisma": "^6.19.3",
    "sharp": "^0.35.2",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
